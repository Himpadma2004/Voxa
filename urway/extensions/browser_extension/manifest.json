{
  "manifest_version": 3,
  "name": "U'rWay - Privacy Behavioral Tracker",
  "version": "1.0.0",
  "description": "Your way, made visible. Privacy-preserving behavioral analytics for personalized adaptive roadmaps.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "U'rWay Control Panel"
  }
}
